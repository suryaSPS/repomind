# Keep the build context small and the image reproducible.

# dependencies — reinstalled from the lockfile inside the image
node_modules
.pnp
.pnp.*

# build output — regenerated by `next build` in the builder stage
.next
out
build

# secrets — injected at runtime via docker-compose env_file, never baked in
.env
.env.*
!.env.example

# local repo clones + vector data (large, host-only)
data/repos

# vcs / tooling / editor cruft
.git
.gitignore
.vercel
.sfdx
.agents
.claude
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
